MLFLOW_VERSION=3.18.0
OIDC_AUTH_VERSION=9.0.5

# Register a confidential OIDC client with this callback URL:
# http://localhost:5000/callback
OIDC_DISCOVERY_URL=https://idp.example.com/.well-known/openid-configuration
OIDC_CLIENT_ID=mlflow-example
OIDC_CLIENT_SECRET=

# Configure the provider to include these groups in its groups claim.
OIDC_GROUPS_ATTRIBUTE=groups
OIDC_GROUP_NAME=example-users
OIDC_ADMIN_GROUP_NAME=example-admins

# Generate once with: python -c 'import secrets; print(secrets.token_hex(32))'
# Keep the same value when restarting the service.
SECRET_KEY=
