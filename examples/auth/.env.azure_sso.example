# Azure AD Configuration
# Get these values from Azure Portal > App registrations

# Azure Tenant ID (Directory ID from Azure Portal)
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Azure Client ID (Application ID from Azure Portal)
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000001

# Azure Client Secret (from Certificates & secrets)
AZURE_CLIENT_SECRET=your-client-secret-here

# OAuth Redirect URI (must match configured in Azure Portal)
# For development: http://localhost:5000/login/callback
# For production: https://your-mlflow-domain.com/login/callback
AZURE_REDIRECT_URI=http://localhost:5000/login/callback

# Database Configuration
DB_USER=mlflow
DB_PASSWORD=mlflow_password

# Optional: MLflow Configuration
# MLFLOW_ENABLE_WORKSPACES=true
# MLFLOW_TRACKING_URI=http://localhost:5000
