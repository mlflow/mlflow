# MLflow Azure SSO with Group-Based Access Control
# Copy as .env.azure_sso_groups and edit with your values

# =============================================================================
# REQUIRED: Azure AD Configuration
# =============================================================================

# Azure Tenant ID (Directory ID from Azure Portal > Properties)
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Azure Client ID (Application ID from App registration)
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000001

# Azure Client Secret (from Certificates & secrets)
AZURE_CLIENT_SECRET=your-client-secret-here

# OAuth Redirect URI (must match configured in Azure Portal)
AZURE_REDIRECT_URI=http://localhost:5000/login/callback

# =============================================================================
# OPTIONAL: Group-Based Access Control
# =============================================================================

# List of ALLOWED Azure AD group IDs (comma-separated)
# Only users in these groups will be allowed to access MLflow
# Copy group IDs from Azure Portal > Groups > Object ID (not the name)
# 
# Examples:
#   AZURE_ALLOWED_GROUPS=12345678-1234-1234-1234-group-id-1
#   AZURE_ALLOWED_GROUPS=12345678-1234-1234-1234-group-id-1,12345678-1234-1234-1234-group-id-2
#
# Leave empty to allow all authenticated users
AZURE_ALLOWED_GROUPS=

# List of DENIED Azure AD group IDs (comma-separated)
# Users in these groups will be denied access, even if in allowed groups
# Useful for: contractors, temporary staff, etc.
#
# Example:
#   AZURE_DENY_GROUPS=12345678-1234-1234-1234-contractors-id
#
AZURE_DENY_GROUPS=

# JWT Claim name that contains user's groups
# Usually "groups" in Azure AD tokens
# Only change if you have custom token configuration
AZURE_GROUP_CLAIM_NAME=groups

# Require group membership for access (true/false)
# Set to "true" to require users to be members of at least one group
# Set to "false" to allow users without groups (if allowed groups not set)
#
# Useful for:
#   true  = Ensure everyone accessing has a specific role/group
#   false = Allow both grouped and ungrouped users
#
AZURE_REQUIRE_GROUP_MEMBERSHIP=false

# =============================================================================
# Database Configuration
# =============================================================================

DB_USER=mlflow
DB_PASSWORD=mlflow_password

# =============================================================================
# Optional: MLflow Configuration
# =============================================================================

# MLFLOW_ENABLE_WORKSPACES=true
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_LOGGING_LEVEL=DEBUG

# =============================================================================
# How to Find Group IDs
# =============================================================================
# 
# Option 1: Azure Portal
#   1. Go to Azure Active Directory > Groups
#   2. Click on your group (e.g., "MLflow-Users")
#   3. Copy the "Object ID" value
#
# Option 2: Azure CLI
#   az ad group list --output table
#   az ad group show --group "MLflow-Users" --query id -o tsv
#
# Option 3: PowerShell
#   Get-MgGroup -Filter "displayName eq 'MLflow-Users'" | Select-Object Id
#
# =============================================================================
